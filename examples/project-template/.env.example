# Copy to .env (never commit it) or export these in your shell / deployment.
NOCTIS_TOKEN=your-bot-token
# 32 bytes, base64. Identical on every process of a Cluster. Generate with:
#   openssl rand -base64 32
NOCTIS_PAYLOAD_KEY=
# Guild used by `--publish-guild` when no id is given (dev only).
NOCTIS_DEV_GUILD=
# Cluster only: shared HTTP rate-limit proxy, `host:port` or `http://host:port`, plain HTTP.
# NOCTIS_HTTP_PROXY=
# Optional gateway proxy shards connect to, `ws://host:port` or `wss://host:port`.
# NOCTIS_GATEWAY_URL=
RUST_LOG=info,noctis=info
