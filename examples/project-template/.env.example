# Copy to .env (never commit it) or export these in your shell / deployment.
NOCTIS_TOKEN=your-bot-token
# 32 bytes as 64 hex digits; signs `signed` Routes. Identical on every process of a
# Cluster. Generate with:
#   openssl rand -hex 32
NOCTIS_PAYLOAD_KEY=
# Guild used by `--publish-guild` when no id is given (dev only).
NOCTIS_DEV_GUILD=
# Optional Boot Flag selection: `all` (default), `none` or `a,b` (`--features` wins).
# NOCTIS_FEATURES=
# Cluster only: shared HTTP rate-limit proxy, `host:port` or `http://host:port`, plain HTTP.
# NOCTIS_HTTP_PROXY=
# Optional gateway proxy shards connect to, `ws://host:port` or `wss://host:port`.
# A gateway proxy must rewrite READY's `resume_gateway_url`, since shards resume there.
# NOCTIS_GATEWAY_URL=
# Optional fixed shard total (a whole number, at least 1). Default: Discord's recommendation.
# NOCTIS_SHARD_TOTAL=
# Cluster only: this process's Shard Range, half-open `start..end` (0..32 = shards 0-31);
# needs the same NOCTIS_SHARD_TOTAL on every process.
# NOCTIS_SHARD_RANGE=
RUST_LOG=info,noctis=info,twilight_http=warn
